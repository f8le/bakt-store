# عام (يظهر في المتصفح، ليس سرًا)
# مهم: متغيرات NEXT_PUBLIC_* تُثبَّت وقت البناء. ضعها في Build variables على Cloudflare (وليس Runtime فقط)
# وإذا غيّرت الدومين لاحقًا فأعد البناء، وإلا ستُرفض طلبات الـ API (فحص Origin) بخطأ 403.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# أسرار: Cloudflare Secrets فقط (wrangler secret put ...) ولا تُرفع إلى GitHub
SUPABASE_SERVICE_ROLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
